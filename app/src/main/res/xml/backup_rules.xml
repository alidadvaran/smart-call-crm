<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (fullBackupContent).
     Call data is sensitive, so the Room database and secure prefs are excluded
     from cloud backup. App preferences may still be backed up. -->
<full-backup-content>
    <exclude domain="database" path="smartcall.db" />
    <exclude domain="database" path="smartcall.db-shm" />
    <exclude domain="database" path="smartcall.db-wal" />
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS everywhere; no cleartext traffic is allowed.
         The self-hosted backend must present a valid TLS certificate
         (e.g. Let's Encrypt), which chains to the system trust store. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

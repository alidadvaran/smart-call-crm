<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme (light). All real UI is drawn with Jetpack Compose /
         Material 3, so we only need a framework theme with no action bar and
         no extra XML-theme dependency. -->
    <style name="Theme.SmartCallCRM" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/teal_700</item>
    </style>
</resources>

# ---- Smart Call CRM server configuration -------------------------------
# Copy to ".env" and fill in. NEVER commit the real .env.

# PostgreSQL connection string.
DATABASE_URL=postgres://smartcall:CHANGE_ME@localhost:5432/smartcall

# HTTP port the Node server listens on (Nginx/Caddy terminates TLS in front).
PORT=8080

# Time zone for scheduled reports.
TZ=Asia/Tehran

# ---- Email (Gmail SMTP with an App Password) ---------------------------
# Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). These stay ONLY here on the server.
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
REPORT_RECIPIENT=a.dadvaran@gmail.com

# Automatic scheduled reports.
ENABLE_DAILY_REPORT=true
ENABLE_WEEKLY_REPORT=true

# ---- Web dashboard (HTTP Basic auth) -----------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_ME_STRONG

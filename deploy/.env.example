# ---- Docker Compose deployment settings --------------------------------
# Copy to ".env" (same folder) and fill in. Keep the real .env private.

# Public domain/subdomain pointing to this server's IP (for HTTPS).
# Example with a free DuckDNS subdomain:
DOMAIN=yourname.duckdns.org

# PostgreSQL password (choose a strong value).
DB_PASSWORD=change_me_strong_db_password

# Time zone for scheduled reports.
TZ=Asia/Tehran

# ---- Email (Gmail SMTP App Password) -----------------------------------
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
REPORT_RECIPIENT=a.dadvaran@gmail.com
ENABLE_DAILY_REPORT=true
ENABLE_WEEKLY_REPORT=true

# ---- Web dashboard login ----------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_strong_dashboard_password

# ---- App self-update ---------------------------------------------------
# Token that authorizes uploading a new APK (used by CI or by you).
# Generate a long random value, e.g.: openssl rand -hex 24
APP_UPLOAD_TOKEN=change_me_random_upload_token
